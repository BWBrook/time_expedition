[sub_resource type="Resource" id="act00_item_ivory_guides"]
script = ExtResource("1_q66mm")
id = &"act00.item.ivory_guides"
display_name = "Ivory guide bars"
description = "Twin ivory guides, smooth, light in hand, and electrically inert; their parallel faces were ground against the same datum."
icon = ExtResource("2_ra77w")

[sub_resource type="Resource" id="act00_item_brass_rails"]
script = ExtResource("1_q66mm")
id = &"act00.item.brass_rails"
display_name = "Brass guide rails"
description = "Two precisely machined brass rails, heavy for their size and plainly conductive, with mounting holes aligned to the model frame."
icon = ExtResource("3_rdcj8")

[sub_resource type="Resource" id="act00_item_crystal_prism"]
script = ExtResource("1_q66mm")
id = &"act00.item.crystal_prism"
display_name = "Crystalline prism"
description = "A transparent, faceted crystal prism whose clean spectral division gives each band of lamplight a separate path."
icon = ExtResource("3_maq04")

[sub_resource type="Resource" id="act00_item_smoked_lens"]
script = ExtResource("1_q66mm")
id = &"act00.item.smoked_lens"
display_name = "Smoked-glass lens"
description = "A smoked-glass lens in a nickel rim; the dark optical glass absorbs incident light rather than dividing its spectrum."
icon = ExtResource("5_pqir0")

[sub_resource type="Resource" id="act00_item_control_levers"]
script = ExtResource("1_q66mm")
id = &"act00.item.control_levers"
display_name = "Paired control levers"
description = "A paired low-friction lever yoke, with the white departure handle moving beside its darker companion."
icon = ExtResource("4_x7gaw")

[sub_resource type="Resource" id="act00_item_clockwork_escapement"]
script = ExtResource("1_q66mm")
id = &"act00.item.clockwork_escapement"
display_name = "Clockwork escapement"
description = "A precise clockwork escapement whose wheel and anchor periodically arrest motion, adding regulation, friction, and delay."
icon = ExtResource("7_g7svf")

[sub_resource type="Resource" id="act00_journal_experiment"]
script = ExtResource("2_2xfis")
id = &"act00.journal.experiment"
title = "The model"
body = "Three functions remain unresolved. The longitudinal guides must be light and electrically inert; the optical core must divide rather than extinguish light; the actuator must move as a low-friction pair. I shall test the model once before I submit the thing to witnesses."

[sub_resource type="Resource" id="act00_journal_materials"]
script = ExtResource("2_2xfis")
id = &"act00.journal.materials"
title = "Candidate materials"
body = "Ivory against brass, clear crystal against smoked glass, free levers against an escapement. Each pair offers similar geometry and a different physical answer. Appearances have agreed to be unhelpful, which is almost considerate of them."

[sub_resource type="Resource" id="act00_journal_components"]
script = ExtResource("2_2xfis")
id = &"act00.journal.components"
title = "Materials assembled"
body = "All six candidates are at hand. Their masses, optical behaviour, conductivity, and resistance differ more honestly than their shapes. Selection should follow the recorded constraints, not the seductions of polished brass."

[sub_resource type="Resource" id="act00_journal_spatial_datum"]
script = ExtResource("2_2xfis")
id = &"act00.journal.spatial_datum"
title = "Spatial datum"
body = "The frame-mounted level settles only at the central mark. Lateral displacement must therefore begin at equilibrium: spatial datum 0."

[sub_resource type="Resource" id="act00_journal_temporal_datum"]
script = ExtResource("2_2xfis")
id = &"act00.journal.temporal_datum"
title = "Temporal datum"
body = "Against the house clock, the trial chronometer loses the interval recovered when advanced one division. Temporal bias must begin at +1."

[sub_resource type="Resource" id="act00_journal_calibration"]
script = ExtResource("2_2xfis")
id = &"act00.journal.calibration"
title = "Calibration"
body = "The mechanism is assembled. Apply the independently observed spatial and temporal datums before drawing the white departure handle through its full travel."

[sub_resource type="Resource" id="act00_journal_misfire"]
script = ExtResource("2_2xfis")
id = &"act00.journal.misfire"
title = "An incomplete displacement"
body = "The frame shuddered but did not depart. The mechanism is sound; the fault lies in my calibration."

[sub_resource type="Resource" id="act00_journal_success"]
script = ExtResource("2_2xfis")
id = &"act00.journal.success"
title = "Eleven seconds"
body = "Four seconds passed in the workshop. The model's chronometer advanced fifteen. An error of measurement remains possible, but an error with a very particular direction, and one that has just crossed the room."

[sub_resource type="Resource" id="act00_observation_notebook"]
script = ExtResource("3_87bj2")
id = &"act00.observation.notebook"
text = "The ink is scarcely dry; the last three lines remain wet enough to shine beside a violet crust at the nib. I have specified functions rather than objects: light inert guides, an element that divides light, and a low-friction paired actuator. Better to make the mechanism answer the question than to tutor myself with labels."

[sub_resource type="Resource" id="act00_observation_notebook_after_datum"]
script = ExtResource("3_87bj2")
id = &"act00.observation.notebook_after_datum"
text = "A pencilled datum now stands beside the inked constraints, obtained from an instrument rather than rescued from preference. One measured fact is not a theory, but it is a welcome reduction in the number of ways I may be foolish."

[sub_resource type="Resource" id="act00_observation_notebook_calibration"]
script = ExtResource("3_87bj2")
id = &"act00.observation.notebook_calibration"
text = "The construction pages are crowded with ticks, oil, and one small burn where confidence preceded insulation. The component constraints and measured datums now agree; whatever follows belongs to experiment, not assembly."

[sub_resource type="Resource" id="act00_observation_diagrams"]
script = ExtResource("3_87bj2")
id = &"act00.observation.diagrams"
text = "Compass arcs converge on three functional blocks, while a rejected field equation has been crossed through hard enough to score the paper beneath. The surviving sketch keeps mass away from the guides, separates the spectrum at the core, and couples the controls without a regulator."

[sub_resource type="Resource" id="act00_observation_diagrams_repeat"]
script = ExtResource("3_87bj2")
id = &"act00.observation.diagrams_repeat"
text = "The trial sketch is less elegant than yesterday's and more likely to work. Elegance is permitted to return after the apparatus has done so."

[sub_resource type="Resource" id="act00_observation_take_guides"]
script = ExtResource("3_87bj2")
id = &"act00.observation.take_guides"
text = "The ivory pair scarcely depresses the balance, while the brass rails drive its other pan down with theatrical certainty. A continuity probe leaves the ivory silent and the brass electrically candid. I take both; resemblance is not a measurement."

[sub_resource type="Resource" id="act00_observation_guides_taken"]
script = ExtResource("3_87bj2")
id = &"act00.observation.guides_taken"
text = "Two pairs of long impressions remain in the cabinet velvet, one pale and one edged with brass filings. The balance still rocks from their comparison, but there is no further candidate hiding beneath it."

[sub_resource type="Resource" id="act00_observation_clock"]
script = ExtResource("3_87bj2")
id = &"act00.observation.clock"
text = "The house clock advances evenly while the trial chronometer drops one division over the marked interval. Advancing the trial regulator by one division restores coincidence across three repetitions. A domestic clock has contributed to temporal physics and will be intolerable about it."

[sub_resource type="Resource" id="act00_observation_clock_repeat"]
script = ExtResource("3_87bj2")
id = &"act00.observation.clock_repeat"
text = "The hands meet their comparison marks again with the trial regulator one division forward. Repetition has failed to improve the romance of the result, which is generally a sign that it may be useful."

[sub_resource type="Resource" id="act00_observation_glassware"]
script = ExtResource("3_87bj2")
id = &"act00.observation.glassware"
text = "A violet residue clings above the meniscus in the exhausted discharge tube, but none has plated onto the insulated ivory chip beside it. The brass coupon carries a bright contact scar. Conductivity leaves better evidence than recollection."

[sub_resource type="Resource" id="act00_observation_glassware_repeat"]
script = ExtResource("3_87bj2")
id = &"act00.observation.glassware_repeat"
text = "The residue has settled and the contact scar has not. Chemistry has completed its testimony; further heating would merely make the room smell decisive."

[sub_resource type="Resource" id="act00_observation_bench_missing"]
script = ExtResource("3_87bj2")
id = &"act00.observation.bench_missing"
text = "Three empty fittings wait on the frame, but the candidate drawers are not yet exhausted. Building from the first plausible object would turn a material question into a habit. I have enough habits already."

[sub_resource type="Resource" id="act00_observation_bench_ready"]
script = ExtResource("3_87bj2")
id = &"act00.observation.bench_ready"
text = "Six candidates lie beside three fittings, and each pair differs in a property the frame can expose. Everything required is here. Now accuracy must do what theory has promised."

[sub_resource type="Resource" id="act00_observation_bench_calibration"]
script = ExtResource("3_87bj2")
id = &"act00.observation.bench_calibration"
text = "The guides sit without loading the field, the prism cuts a narrow spectrum, and the paired handles move together without hesitation. Construction is no longer the uncertainty. The scales must now be made to agree with the room's evidence."

[sub_resource type="Resource" id="act00_observation_spirit_level"]
script = ExtResource("3_87bj2")
id = &"act00.observation.spirit_level"
text = "The bubble runs left under negative excitation and right under positive, but settles between its etched lines at the central setting. I repeat the reversal twice with the same result. The spatial datum is equilibrium, not an offset disguised as one."

[sub_resource type="Resource" id="act00_observation_spirit_level_repeat"]
script = ExtResource("3_87bj2")
id = &"act00.observation.spirit_level_repeat"
text = "The bubble returns to the centre mark after disturbance from either side. It is pleasant when an instrument answers the same question without developing a personality."

[sub_resource type="Resource" id="act00_observation_window"]
script = ExtResource("3_87bj2")
id = &"act00.observation.window"
text = "Rain stipples the Richmond glass and runs downward in separate threads before joining at the sill. Beyond it, carriages pass at ordinary speed, indifferent to the several kinds of time accumulating on this bench."

[sub_resource type="Resource" id="act00_observation_window_repeat"]
script = ExtResource("3_87bj2")
id = &"act00.observation.window_repeat"
text = "The rain has strengthened enough to erase the garden and leave my reflection among the instruments. The outside world remains a useful control, chiefly because it has not consented to the experiment."

[sub_resource type="Resource" id="act00_observation_take_prism"]
script = ExtResource("3_87bj2")
id = &"act00.observation.take_prism"
text = "The clear prism throws a clean spectral ladder across the card; the smoked lens leaves only a charcoal oval and a weaker lamp. Both share the cradle's width. I take both, since geometry has arranged an alibi for bad optics."

[sub_resource type="Resource" id="act00_observation_prism_taken"]
script = ExtResource("3_87bj2")
id = &"act00.observation.prism_taken"
text = "The optical bench retains a bright spectrum on the card and a dark ring where the smoked lens rested. Neither candidate remains, only the evidence by which they should be judged."

[sub_resource type="Resource" id="act00_observation_take_levers"]
script = ExtResource("3_87bj2")
id = &"act00.observation.take_levers"
text = "The paired levers move through their arc under a breath, the white handle keeping exact company with its mate. The escapement advances tooth by tooth and arrests them with admirable precision. I take both; precision and freedom are not synonyms."

[sub_resource type="Resource" id="act00_observation_levers_taken"]
script = ExtResource("3_87bj2")
id = &"act00.observation.levers_taken"
text = "Empty pivot pins and two ruby-coloured oil marks remain on the tray. The control candidates are already in hand, and the rejected frames can offer nothing further tonight."

[sub_resource type="Resource" id="act00_observation_displacement_rig"]
script = ExtResource("3_87bj2")
id = &"act00.observation.displacement_rig"
text = "This abandoned displacement rig carried a coil, a field compass, and several optimistic kilograms across the floor before it fused its contact. It was field apparatus for an earlier experiment, not a larger version of the present machine. Failure becomes less embarrassing once properly labelled."

[sub_resource type="Resource" id="act00_observation_displacement_rig_calibration"]
script = ExtResource("3_87bj2")
id = &"act00.observation.displacement_rig_calibration"
text = "The old rig's compass still kicks left and right with unequal excitation, though its carriage cannot move. It confirms direction but says nothing about cadence. I shall not ask a burnt contact to become a chronometer."

[sub_resource type="Resource" id="act00_observation_gas_lamp"]
script = ExtResource("3_87bj2")
id = &"act00.observation.gas_lamp"
text = "A narrowed gas flame gives the prism a sharper spectrum and the smoked lens a darker extinction. The mantle flutters whenever the frame is energised, a crude but immediate witness to each pulse."

[sub_resource type="Resource" id="act00_observation_gas_lamp_repeat"]
script = ExtResource("3_87bj2")
id = &"act00.observation.gas_lamp_repeat"
text = "The flame steadies when the circuit opens and bows towards the frame when it closes. It is not a measuring instrument, but it has the virtue of reacting before I can invent an explanation."

[sub_resource type="Resource" id="act00_observation_drafting_stool"]
script = ExtResource("3_87bj2")
id = &"act00.observation.drafting_stool"
text = "A calculation sheet lies under the stool, rejected after one denominator quietly changed dimensions halfway down the page. The stool has prevented it from returning to the desk, which is the soundest peer review it has received."

[sub_resource type="Resource" id="act00_observation_drafting_stool_repeat"]
script = ExtResource("3_87bj2")
id = &"act00.observation.drafting_stool_repeat"
text = "The discarded calculation remains pinned beneath one brass foot. Its arithmetic has not improved under pressure."

[sub_resource type="Resource" id="act00_observation_specimen_cabinet"]
script = ExtResource("3_87bj2")
id = &"act00.observation.specimen_cabinet"
text = "The cabinet seals waxed coils, cracked dielectrics, and a moth whose label predates my tenancy. None belongs to the model, but each records the useful moment when an assumption met matter."

[sub_resource type="Resource" id="act00_observation_specimen_cabinet_repeat"]
script = ExtResource("3_87bj2")
id = &"act00.observation.specimen_cabinet_repeat"
text = "Dust has entered the cabinet despite the felt seal, while common sense remains excluded with remarkable success. I leave both arrangements undisturbed."

[sub_resource type="Resource" id="act00_observation_apparatus"]
script = ExtResource("3_87bj2")
id = &"act00.observation.apparatus"
text = "A respectable collection of failures, each one useful enough to deserve dusting. The largest is an earlier displacement rig, not the machine I mean one day to build."

[sub_resource type="Resource" id="act00_observation_wrong_slot"]
script = ExtResource("3_87bj2")
id = &"act00.observation.wrong_slot"
text = "No. The fitting refuses it without force, which is more wisdom than many men display."

[sub_resource type="Resource" id="act00_observation_component_fitted"]
script = ExtResource("3_87bj2")
id = &"act00.observation.component_fitted"
text = "The component seats without force and the witness marks remain aligned. One uncertainty removed; two are not invited to celebrate."

[sub_resource type="Resource" id="act00_observation_assembly_complete"]
script = ExtResource("3_87bj2")
id = &"act00.observation.assembly_complete"
text = "The three functions now share one frame, and each can still be examined independently. Construction has stopped being an excuse. Calibration may commence."

[sub_resource type="Resource" id="act00_observation_misfire"]
script = ExtResource("3_87bj2")
id = &"act00.observation.misfire"
text = "A displacement begins, folds sideways, and collapses before the bench loses sight of the frame. The construction remains intact; the calibration, annoyingly but usefully, has supplied the failure."

[sub_resource type="Resource" id="act00_observation_excursion"]
script = ExtResource("3_87bj2")
id = &"act00.observation.excursion"
text = "The frame thins to a bright edge and vanishes without smoke, debris, or the customary assistance of metaphor. For four seconds the bench is indisputably empty."

[sub_resource type="Resource" id="act00_observation_return"]
script = ExtResource("3_87bj2")
id = &"act00.observation.return"
text = "The model returns with its oil still warm and its frame displaced less than a hair from the witness marks. Its chronometer reads fifteen seconds; the workshop clock has advanced four. I distrust both instruments equally, which is an excellent reason to repeat the experiment at full scale."

[sub_resource type="Resource" id="act00_observation_reject_ivory_guides_crystal_prism"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.ivory_guides.crystal_prism"
text = "The ivory is light and inert, but the optical cradle requires a faceted body to interrupt the light path. These smooth bars bridge the cradle without presenting any useful surface to the beam."

[sub_resource type="Resource" id="act00_observation_reject_ivory_guides_control_levers"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.ivory_guides.control_levers"
text = "The light ivory bars have neither a lever yoke nor joints for the paired pivots. Forcing them across the actuator pivot spacing would convert an electrical virtue into a mechanical absurdity."

[sub_resource type="Resource" id="act00_observation_reject_brass_rails_ivory_guides"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.brass_rails.ivory_guides"
text = "The brass rails meet the guide sockets neatly, which makes their failure worth noticing. They are heavy and conductive; the longitudinal field would acquire both inertia and a path to earth."

[sub_resource type="Resource" id="act00_observation_reject_brass_rails_crystal_prism"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.brass_rails.crystal_prism"
text = "Machining cannot make heavy, conductive brass serve as an optical element. The optical cradle encloses an opaque rail and receives no divided light path at all."

[sub_resource type="Resource" id="act00_observation_reject_brass_rails_control_levers"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.brass_rails.control_levers"
text = "The heavy brass rails span the paired pivots but provide neither articulation nor a common lever yoke. Conductivity is no compensation for incompatible actuator geometry."

[sub_resource type="Resource" id="act00_observation_reject_crystal_prism_ivory_guides"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.crystal_prism.ivory_guides"
text = "The transparent prism enters one guide socket and leaves the other bare; its faceted body cannot occupy two parallel channels. A longitudinal guide must constrain motion, not merely sparkle beside it."

[sub_resource type="Resource" id="act00_observation_reject_crystal_prism_control_levers"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.crystal_prism.control_levers"
text = "The transparent, faceted prism has no journals for the actuator pivots and no lever yoke to move them together. A clean spectrum is persuasive evidence, but not of mechanical fitness."

[sub_resource type="Resource" id="act00_observation_reject_smoked_lens_ivory_guides"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.smoked_lens.ivory_guides"
text = "The smoked glass is broad, dark, and absorptive, while the guide sockets demand two slender longitudinal members. It touches both parallel channels badly and constrains neither."

[sub_resource type="Resource" id="act00_observation_reject_smoked_lens_crystal_prism"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.smoked_lens.crystal_prism"
text = "The smoked glass fits the optical cradle, but it absorbs the lamp instead of dividing it. Correct geometry is only half an answer when the light path emerges dimmer and spectrally unchanged."

[sub_resource type="Resource" id="act00_observation_reject_smoked_lens_control_levers"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.smoked_lens.control_levers"
text = "The smoked glass offers no lever yoke, and its nickel rim cannot engage the paired pivots. An absorbing optical surface is particularly unhelpful where actuator geometry requires free rotation."

[sub_resource type="Resource" id="act00_observation_reject_control_levers_ivory_guides"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.control_levers.ivory_guides"
text = "The low-friction lever yoke enters the longitudinal guide fitting crosswise, with the white handle projecting beyond one guide socket. It can initiate motion, but it cannot constrain a parallel translation."

[sub_resource type="Resource" id="act00_observation_reject_control_levers_crystal_prism"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.control_levers.crystal_prism"
text = "The white handle and low-friction lever yoke occupy the optical cradle but leave its light path blocked by metal. Nothing in this geometry can divide the beam, however agreeably the pivots move."

[sub_resource type="Resource" id="act00_observation_reject_clockwork_escapement_ivory_guides"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.clockwork_escapement.ivory_guides"
text = "The escapement wheel is precise, but its periodic arrest and added friction are fatal in the guide sockets. The longitudinal motion requires two continuous low-mass surfaces, not regulated hesitation."

[sub_resource type="Resource" id="act00_observation_reject_clockwork_escapement_crystal_prism"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.clockwork_escapement.crystal_prism"
text = "The clockwork escapement fills the optical cradle with brass teeth and periodic arrest. Its friction may regulate a clock admirably, but no transparent or faceted surface reaches the light path."

[sub_resource type="Resource" id="act00_observation_reject_clockwork_escapement_control_levers"]
script = ExtResource("3_87bj2")
id = &"act00.observation.reject.clockwork_escapement.control_levers"
text = "The escapement's anchor can rock between the actuator pivots, yet its purpose is periodic arrest rather than a free paired command. Its friction would make every departure a negotiation with a clock."

[sub_resource type="Resource" id="act00_observation_misfire_left_slow"]
script = ExtResource("3_87bj2")
id = &"act00.observation.misfire.left_slow"
text = "The lateral field pull is left of centre; the frame leans towards the cabinet before settling. The temporal cadence is slow, with each impulse arriving late enough to count by ear."

[sub_resource type="Resource" id="act00_observation_misfire_left_correct"]
script = ExtResource("3_87bj2")
id = &"act00.observation.misfire.left_correct"
text = "The lateral field pull is left of centre, although the frame no longer gains or loses ground between beats. The temporal cadence is correct; only the sideways strain remains to be removed."

[sub_resource type="Resource" id="act00_observation_misfire_left_fast"]
script = ExtResource("3_87bj2")
id = &"act00.observation.misfire.left_fast"
text = "The lateral field pull is left of centre and draws a blue edge along the cabinet side of the frame. The temporal cadence is fast, crowding one impulse upon the next before the anchor can settle."

[sub_resource type="Resource" id="act00_observation_misfire_centred_slow"]
script = ExtResource("3_87bj2")
id = &"act00.observation.misfire.centred_slow"
text = "The lateral field pull is centred; neither guide carries more strain than its fellow. The temporal cadence is slow, and the model completes each pulse after the chronometer has already advanced."

[sub_resource type="Resource" id="act00_observation_misfire_centred_fast"]
script = ExtResource("3_87bj2")
id = &"act00.observation.misfire.centred_fast"
text = "The lateral field pull is centred, for once giving me no quarrel. The temporal cadence is fast, a clipped succession of impulses that outruns the regulating beat."

[sub_resource type="Resource" id="act00_observation_misfire_right_slow"]
script = ExtResource("3_87bj2")
id = &"act00.observation.misfire.right_slow"
text = "The lateral field pull is right of centre; the prism cradle shivers towards the window. The temporal cadence is slow, each pulse lingering when it ought to release."

[sub_resource type="Resource" id="act00_observation_misfire_right_correct"]
script = ExtResource("3_87bj2")
id = &"act00.observation.misfire.right_correct"
text = "The lateral field pull is right of centre, visible in the unequal flex of the ivory bars. The temporal cadence is correct; lateral equilibrium alone prevents a clean displacement."

[sub_resource type="Resource" id="act00_observation_misfire_right_fast"]
script = ExtResource("3_87bj2")
id = &"act00.observation.misfire.right_fast"
text = "The lateral field pull is right of centre and the window-side guide sings under strain. The temporal cadence is fast, delivering the next impulse before the previous one has decayed."

[resource]
script = ExtResource("4_ra77w")
act_id = &"act00"
title = "Act 0: The Model"
